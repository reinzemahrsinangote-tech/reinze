        <tbody>
            <tr><td>IT101</td><td>Programming 1</td><td>1.75</td></tr>
            <tr><td>IT102</td><td>Data Structures</td><td>1.50</td></tr>
            <tr><td>IT103</td><td>Web Development</td><td>1.25</td></tr>
        </tbody>
    </table>
</div>